% int_lin_ne substitution: UNSAT via contradictory ne
% z = 5 - y (def), then z + y != 5 => (5-y)+y != 5 => 5 != 5 (0 != 0): UNSAT
var 1..5: x :: output_var;
var 1..5: y :: output_var;
var 1..10: z :: is_defined_var;
constraint int_lin_eq([1, 1], [z, y], 5);
constraint int_lin_ne([1, 1], [z, y], 5);
solve satisfy;
