var 1..1: x1 :: output_var;
var 2..2: x2 :: output_var;
var 1..1: x3 :: output_var;
array [1..3] of var int: x = [x1, x2, x3];
var 0..3: c1 :: output_var;
var 0..3: c2 :: output_var;
var 0..3: c3 :: output_var;
array [1..3] of var int: counts = [c1, c2, c3];
array [1..3] of int: cover = [1, 2, 5];
constraint sabori_global_cardinality(x, cover, counts);
solve satisfy;
