var 1..2: x1 :: output_var;
var 1..2: x2 :: output_var;
array [1..2] of var int: x = [x1, x2];
var 0..2: c1 :: output_var;
var 0..2: c2 :: output_var;
array [1..2] of var int: counts = [c1, c2];
array [1..2] of int: cover = [1, 2];
constraint sabori_global_cardinality(x, cover, counts);
solve satisfy;
